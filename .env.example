# LinkedIn AI Agent — Environment Variables
#
# Only ZAI_API_KEY is required for the configured GLM model (zai/glm-5.2).
# Get a free key at https://z.ai
# The agent uses browser-based authentication exclusively — no LinkedIn API keys.

# Required for agent execution via OpenCode
ZAI_API_KEY=

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
