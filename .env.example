# LinkedIn AI Agent — Variables de Entorno
#
# Solo ZAI_API_KEY es requerida para el modelo GLM configurado (zai/glm-5.2).
# Obtén una key gratis en https://z.ai
# El agente usa exclusivamente autenticación basada en navegador — sin API keys de LinkedIn.

# Requerida para la ejecución del agente vía OpenCode
ZAI_API_KEY=

# Opcional: nivel de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
