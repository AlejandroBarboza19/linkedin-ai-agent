{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "linkedin_server": {
      "type": "local",
      "command": ["python", "-m", "mcp.linkedin_server.server"],
      "enabled": true
    }
  },
  "agent": {
    "linkedin-agent": {
      "description": "LinkedIn content automation agent using Playwright with Human in the Loop",
      "prompt": "{file:agents/linkedin_agent.md}"
    }
  },
  "skills": {
    "paths": ["skills/linkedin_poster"]
  },
  "model": "openrouter/glm-5.2",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  }
}
